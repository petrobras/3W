#!/bin/bash
set -u

# Manual-only helper: this script is NOT executed by any CI workflow.
# It exists to let contributors sanity-check notebooks locally before or
# after 3W Toolkit changes, since some notebooks can take hours to run
# (model training, large dataset processing) and standard GitHub-hosted
# runners have no GPU and limited job/disk time.
#
# Usage:
#   ./bin/nb_test [--all | --not-basic] [<path>]
#
# Categories:
#   DEMOS_BASIC     - Notebooks the project is committed to keeping working
#                      across 3W Toolkit releases: toolkit/demos,
#                      dataset/demos/_basic and benchmarks/*/demo/_basic
#                      (once created). A failure here is an ERROR
#                      (non-zero exit code).
#   DEMOS_NOT_BASIC - All other demos/tutorials (no such commitment).
#                      A failure here is a WARNING only and does not
#                      affect the exit code.
#
# Options:
#   (none)       - Default. Test DEMOS_BASIC only.
#   --all        - Test DEMOS_BASIC + DEMOS_NOT_BASIC.
#   --not-basic  - Test DEMOS_NOT_BASIC only.
#   <path>       - Legacy mode: run every *.ipynb found under the given
#                  path, reported as a single uncategorized WARNING batch.
#
# Requirements:
#   Install the "notebooks" extra BEFORE running this script. It contains the
#   dependencies required by the notebooks under test:
#
#     uv sync --extra notebooks
#
#   The script automatically prefers the project's .venv when it exists, so
#   there is no need to activate the virtual environment manually.

ALL=0
NOT_BASIC=0
LEGACY_PATH=""

usage() {
    echo "Usage: $0 [--all | --not-basic] [<path>]" >&2
}

for arg in "$@"; do
    case "$arg" in
        --all)
            ALL=1
            ;;
        --not-basic)
            NOT_BASIC=1
            ;;
        -*)
            echo "Unknown option: $arg" >&2
            usage
            exit 2
            ;;
        *)
            if [ -n "$LEGACY_PATH" ]; then
                echo "Only one path may be provided." >&2
                usage
                exit 2
            fi
            LEGACY_PATH="$arg"
            ;;
    esac
done

if [ "$ALL" -eq 1 ] && [ "$NOT_BASIC" -eq 1 ]; then
    echo "Options --all and --not-basic cannot be combined." >&2
    usage
    exit 2
fi

if [ -n "$LEGACY_PATH" ] && { [ "$ALL" -eq 1 ] || [ "$NOT_BASIC" -eq 1 ]; }; then
    echo "A path cannot be combined with --all or --not-basic." >&2
    usage
    exit 2
fi

cd "$(dirname "$0")/.."

# benchmarks/*/demo/_basic and its sibling non-basic dirs don't exist yet;
# only expand the glob into the arrays once they do.
shopt -s nullglob
BENCH_BASIC=(benchmarks/*/demo/_basic)
shopt -u nullglob

DEMOS_BASIC=(
    "toolkit/demos"
    "dataset/demos/_basic"
    "${BENCH_BASIC[@]}"
)

DEMOS_NOT_BASIC=(
    "dataset/demos"
    "resources/introduction_to_3w_toolkit_v2.0.0"
    "resources/introduction_to_3w_dataset_v2.0.0"
    "resources/introduction_to_ml_applied_to_mts"
)


# Resolve the Python interpreter. Prefer the project's virtual environment.
PROJECT_ROOT="$(pwd)"
if [ -x "$PROJECT_ROOT/.venv/Scripts/python.exe" ]; then
    PYTHON="$PROJECT_ROOT/.venv/Scripts/python.exe"
elif [ -x "$PROJECT_ROOT/.venv/bin/python" ]; then
    PYTHON="$PROJECT_ROOT/.venv/bin/python"
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    PYTHON=python.exe
fi

TEMPDIR="$(mktemp -d)"
trap 'rm -rf -- "$TEMPDIR"' EXIT

# Notebooks may save arbitrary kernel names (e.g. "p310-forge") in their
# metadata, which breaks execution on other contributors' machines. Register
# a temporary kernelspec that always points to the resolved interpreter and
# force nbconvert to use it regardless of each notebook's saved kernelspec.
KERNEL_NAME="nb_test"
mkdir -p "$TEMPDIR/kernels/$KERNEL_NAME"
cat > "$TEMPDIR/kernels/$KERNEL_NAME/kernel.json" <<EOF
{
  "argv": ["${PYTHON//\\//}", "-m", "ipykernel_launcher", "-f", "{connection_file}"],
  "display_name": "$KERNEL_NAME",
  "language": "python"
}
EOF
export JUPYTER_PATH="$TEMPDIR"

# Full nbconvert/traceback output is noisy; redirect it to per-notebook logs
# here instead of the terminal. This directory is NOT auto-removed, so
# failure logs remain available for inspection after the run.
LOGDIR="$(mktemp -d)"

echo "Saving executed notebooks to $TEMPDIR"
echo "Saving execution logs to $LOGDIR"

# Runs every *.ipynb found under the given directories. Notebooks living
# under a "_basic" subdirectory of a DEMOS_NOT_BASIC dir are skipped, since
# they belong to the corresponding DEMOS_BASIC entry instead.
# Echoes one line per notebook (OK/FAIL) and returns the failure count.
run_notebooks () {
    local label="$1"
    shift
    local dirs=("$@")
    local failures=0
    local nb
    local nbs=()

    for dir in "${dirs[@]}"; do
        if [ ! -d "$dir" ]; then
            echo -e "\033[0;33m[$label] Directory not found, skipping: $dir\033[0m"
            continue
        fi

        # Collect the notebook list into an array first: piping "find" directly
        # into a "while read" loop shares stdin with jupyter-nbconvert's kernel
        # subprocess, which can consume the pipe and silently skip notebooks.
        #
        # "_basic" notebooks are excluded only from NOT_BASIC searches, since
        # they are already covered by DEMOS_BASIC.
        if [ "$label" = "NOT_BASIC" ]; then
            mapfile -t nbs < <(
                find "$dir" \
                    -type f \
                    -name "*.ipynb" \
                    -not -path "*/_basic/*" \
                    -not -path "*/.ipynb_checkpoints/*" \
                    | sort
            )
        else
            mapfile -t nbs < <(
                find "$dir" \
                    -type f \
                    -name "*.ipynb" \
                    -not -path "*/.ipynb_checkpoints/*" \
                    | sort
            )
        fi

        for nb in "${nbs[@]}"; do
            echo -e "\033[0;33m[$label] Testing $nb.\033[0m"

            # Preserve the notebook path in the log filename so notebooks with
            # the same basename do not overwrite each other's logs.
            local safe_name="${nb//\//_}"
            local log="$LOGDIR/${label}_${safe_name}.log"
            local nb_dir="$(dirname "$nb")"
            local nb_file="$(basename "$nb")"

            if (cd "$nb_dir" && "$PYTHON" -m nbconvert \
                "$nb_file" \
                --to notebook \
                --execute \
                --ExecutePreprocessor.kernel_name="$KERNEL_NAME" \
                --output-dir "$TEMPDIR" \
                >"$log" 2>&1); then

                echo -e "\033[0;32m[$label] $nb executed successfully.\033[0m"
            else
                echo -e "\033[0;31m[$label] $nb FAILED. Log: $log\033[0m"
                failures=$((failures + 1))
            fi
        done
    done

    return "$failures"
}

basic_failures=0
not_basic_failures=0

if [ -n "$LEGACY_PATH" ]; then
    run_notebooks "OTHER" "$LEGACY_PATH"
    not_basic_failures=$?
elif [ "$ALL" -eq 1 ]; then
    run_notebooks "BASIC" "${DEMOS_BASIC[@]}"
    basic_failures=$?
    run_notebooks "NOT_BASIC" "${DEMOS_NOT_BASIC[@]}"
    not_basic_failures=$?
elif [ "$NOT_BASIC" -eq 1 ]; then
    run_notebooks "NOT_BASIC" "${DEMOS_NOT_BASIC[@]}"
    not_basic_failures=$?
else
    run_notebooks "BASIC" "${DEMOS_BASIC[@]}"
    basic_failures=$?
fi

echo ""
echo "Summary:"
echo "  Basic demo failures (ERROR):        $basic_failures"
echo "  Non-basic demo failures (WARNING):  $not_basic_failures"

if [ "$basic_failures" -gt 0 ]; then
    echo -e "\033[0;31mBasic demos have failing notebooks. This must be fixed before release.\033[0m"
    exit 1
fi

if [ "$not_basic_failures" -gt 0 ]; then
    echo -e "\033[0;33mSome non-basic demos failed. Please review them, but this does not block the build.\033[0m"
fi

exit 0
