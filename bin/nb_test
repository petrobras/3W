#!/bin/bash
set -u

# This script tests (runs) Jupyter Notebooks and reports which tests failed.
#
# The following categories of Jupyter Notebooks are considered:
#
#   BASIC_DEMOS     - those that the 3W Project leaders intend to maintain without fail  
#                     throughout updates to the 3W Dataset and the 3W Toolkit. Failures 
#                     that occur when running Jupyter Notebook in this category are 
#                     reported as ERRORS.
#   NOT_BASIC_DEMOS - those that the 3W Project leaders expect the 3W Community to 
#                     maintain without fail throughout updates to the 3W Dataset and the 
#                     3W Toolkit. Failures that occur when running Jupyter Notebook in 
#                     this category are reported as WARNINGS.
#
# To run this script, you need to install packages in the “notebooks” extra group:
#
#   uv sync --extra notebooks
#
# Usage:
#
#   uv run bash nb_test [--all|--not-basic|<path>]
#
# Options:
#
#   (none)          - Default. Only BASIC_DEMOS are tested.
#   --all           - BASIC_DEMOS and NOT_BASIC_DEMOS are tested.
#   --not-basic     - Only NOT_BASIC_DEMOS are tested.
#   <path>          - Only *.ipynb files found under the given path are tested.
#

ALL=0
NOT_BASIC_DEMO=0
LEGACY_PATH=""

usage() {
    echo "Usage: uv run bash nb_test [--all|--not-basic|<path>]" >&2
}

for arg in "$@"; do
    case "$arg" in
        --all)
            ALL=1
            ;;
        --not-basic)
            NOT_BASIC_DEMO=1
            ;;
        -*)
            echo "Unknown option: $arg" >&2
            usage
            exit 2
            ;;
        *)
            if [ -n "$LEGACY_PATH" ]; then
                echo "Only one path may be provided" >&2
                usage
                exit 2
            fi
            LEGACY_PATH="$arg"
            ;;
    esac
done

if [ "$ALL" -eq 1 ] && [ "$NOT_BASIC_DEMO" -eq 1 ]; then
    echo "Options --all and --not-basic cannot be combined" >&2
    usage
    exit 2
fi

if [ -n "$LEGACY_PATH" ] && { [ "$ALL" -eq 1 ] || [ "$NOT_BASIC_DEMO" -eq 1 ]; }; then
    echo "A path cannot be combined with --all or --not-basic options" >&2
    usage
    exit 2
fi

cd "$(dirname "$0")/.."

# The benchmarks/*/demo/_basic and its sibling not-basic dirs don't exist yet. Only 
# expand the glob into the arrays once they do
shopt -s nullglob
BENCH_BASIC=(benchmarks/*/demo/_basic)
shopt -u nullglob

BASIC_DEMOS=(
    "toolkit/demos"
    "dataset/demos/_basic"
    "${BENCH_BASIC[@]}"
)

NOT_BASIC_DEMOS=(
    "dataset/demos"
    "resources/introduction_to_3w_toolkit_v2.0.0"
    "resources/introduction_to_3w_dataset_v2.0.0"
    "resources/introduction_to_ml_applied_to_mts"
)

# Resolve the Python interpreter. Prefer the project's virtual environment
PROJECT_ROOT="$(pwd)"
if [ -x "$PROJECT_ROOT/.venv/Scripts/python.exe" ]; then
    PYTHON="$PROJECT_ROOT/.venv/Scripts/python.exe"
elif [ -x "$PROJECT_ROOT/.venv/bin/python" ]; then
    PYTHON="$PROJECT_ROOT/.venv/bin/python"
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    PYTHON=python.exe
fi

TEMPDIR="$(mktemp -d)"
trap 'rm -rf -- "$TEMPDIR"' EXIT

# Jupyter Notebooks may save arbitrary kernel names (e.g. "p310-forge") in their 
# metadata, which breaks execution on other contributors' machines. So register a 
# temporary kernelspec that always points to the resolved interpreter and force 
# the nbconvert to use it regardless of each Jupyter Notebook's saved kernelspec.
# Convert the interpreter path on Windows and keep it unchanged elsewhere.
KERNEL_NAME="nb_test"
KERNEL_PYTHON="$(cygpath -m "$PYTHON" 2>/dev/null || printf '%s' "$PYTHON")"
KERNEL_PYTHON="${KERNEL_PYTHON//\\//}"
mkdir -p "$TEMPDIR/kernels/$KERNEL_NAME"
cat > "$TEMPDIR/kernels/$KERNEL_NAME/kernel.json" <<EOF
{
  "argv": ["$KERNEL_PYTHON", "-m", "ipykernel_launcher", "-f", "{connection_file}"],
  "display_name": "$KERNEL_NAME",
  "language": "python"
}
EOF
export JUPYTER_PATH="$TEMPDIR"

# Full nbconvert/traceback output is noisy. Redirect it to logs instead of the terminal. 
# This directory is NOT auto-removed. So failure logs remain available for inspection 
# after the test
LOGDIR="$(mktemp -d)"

echo "Saving executed notebooks to $TEMPDIR ..."
echo "Saving execution logs to $LOGDIR ..."

# Runs every *.ipynb found under the given directories. Notebooks living under a 
# "_basic" subdirectory of a NOT_BASIC_DEMOS dir are skipped, since they belong to the 
# BASIC_DEMOS category. Echoes one line per notebook (OK/FAIL) and returns the failure 
# count
run_notebooks () {
    local label="$1"
    shift
    local dirs=("$@")
    local failures=0
    local nb
    local nbs=()

    for dir in "${dirs[@]}"; do
        if [ ! -d "$dir" ]; then
            echo -e "\033[0;33m[$label] Directory not found, skipping: $dir\033[0m"
            continue
        fi

        # Collect the Jupyter Notebook list into an array first: piping "find" directly
        # into a "while read" loop shares stdin with jupyter-nbconvert's kernel
        # subprocess, which can consume the pipe and silently skip notebooks. "_basic" 
        # Jupyter Notebooks are excluded only from NOT_BASIC_DEMO searches, since they are 
        # already covered by BASIC_DEMOS category
        if [ "$label" = "NOT_BASIC_DEMO" ]; then
            mapfile -t nbs < <(
                find "$dir" \
                    -type f \
                    -name "*.ipynb" \
                    -not -path "*/_basic/*" \
                    -not -path "*/.ipynb_checkpoints/*" \
                    | sort
            )
        else
            mapfile -t nbs < <(
                find "$dir" \
                    -type f \
                    -name "*.ipynb" \
                    -not -path "*/.ipynb_checkpoints/*" \
                    | sort
            )
        fi

        for nb in "${nbs[@]}"; do
            echo -e "\033[0;33m[$label] Testing $nb ...\033[0m"

            # Preserve the Jupyter Notebook path in the log filename so those with
            # the same basename do not overwrite each other's logs
            local safe_name="${nb//\//_}"
            local log="$LOGDIR/${label}_${safe_name}.log"
            local nb_dir="$(dirname "$nb")"
            local nb_file="$(basename "$nb")"

            # if (cd "$nb_dir" && "$PYTHON" -m nbconvert \
            #     "$nb_file" \
            #     --to notebook \
            #     --execute \
            #     --ExecutePreprocessor.kernel_name="$KERNEL_NAME" \
            #     --output-dir "$TEMPDIR" \
            #     >"$log" 2>&1); then
            if false; then
                echo -e "\033[0;32m[$label] $nb executed successfully\033[0m"
            else
                echo -e "\033[0;31m[$label] $nb FAILED. Log in $log\033[0m"
                failures=$((failures + 1))
            fi
        done
    done

    return "$failures"
}

basic_failures=0
not_basic_failures=0

if [ -n "$LEGACY_PATH" ]; then
    run_notebooks "OTHER" "$LEGACY_PATH"
    not_basic_failures=$?
elif [ "$ALL" -eq 1 ]; then
    run_notebooks "BASIC_DEMO" "${BASIC_DEMOS[@]}"
    basic_failures=$?
    run_notebooks "NOT_BASIC_DEMO" "${NOT_BASIC_DEMOS[@]}"
    not_basic_failures=$?
elif [ "$NOT_BASIC_DEMO" -eq 1 ]; then
    run_notebooks "NOT_BASIC_DEMO" "${NOT_BASIC_DEMOS[@]}"
    not_basic_failures=$?
else
    run_notebooks "BASIC_DEMO" "${BASIC_DEMOS[@]}"
    basic_failures=$?
fi

echo "Summary:"
echo "   ERRORS (failures in BASIC_DEMOS):        $basic_failures"
echo "   WARNINGS (failures in NOT_BASIC_DEMOS):  $not_basic_failures"

exit 0
